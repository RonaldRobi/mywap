# Salin ke fastlane/.env dan isi. Jangan commit fail .env sebenar.

# iOS — App Store Connect API key (.p8 + key id + issuer id dalam satu JSON)
# {
#   "key_id": "XXXXXXXXXX",
#   "issuer_id": "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx",
#   "key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# }
ASC_KEY_JSON=asc_key.json

# Android — service account JSON dari Play Console > Setup > API access
PLAY_JSON_KEY=play_service_account.json

# Pilihan
# PLAY_TRACK=internal
# IPA_PATH=../build/ios/ipa/myWAP.ipa
# AAB_PATH=../build/app/outputs/bundle/release/app-release.aab
